TIMEZONE=Europe/Vilnius
SCHEDULE=hourly
MIN_RAM_GB=12
ALLOWED_CPUS=N100,N150,N97
TARGET_PRICE_EUR=175
PRIORITY_THRESHOLDS=75,100,125,150,175
DEFAULT_CURRENCY=EUR
DATABASE_PATH=/state/watcher.sqlite
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BRAVE_API_KEY=
# Confirm your subscription permits storing search results before enabling.
BRAVE_STORAGE_LICENSE_CONFIRMED=false
SEARCH_INTERVAL_SECONDS=1.1
ENABLE_AUTHORIZED_DIRECT_CHECKS=false
ENABLE_DASHBOARD=false
LOG_LEVEL=INFO
RETENTION_DAYS=180
VERIFICATION_TTL_HOURS=24

# Secondary candidates can be enabled by raising this above TARGET_PRICE_EUR.
MAX_ASKING_PRICE_EUR=175
# Set true only with authorization covering public browser searches.
# Authorization is recorded in config/direct-authorization.json.
# Browser behavior is configured in config/browser.json.

NOTIFY_MODE=deals_and_daily

DAILY_REPORT_TIME=19:00
